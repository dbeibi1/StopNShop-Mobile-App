<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screen_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout  android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/products_heading" style="@style/Text.StopNShop.Title" android:layout_width="match_parent" android:layout_height="wrap_content"  />
<TextView android:id="@+id/products_count" style="@style/Text.StopNShop.Support" android:layout_width="match_parent" android:layout_height="wrap_content"  android:layout_marginTop="8dp"/>
<TextView  style="@style/Text.StopNShop.Support" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/demo_catalogue" android:layout_marginTop="12dp"/>
<LinearLayout android:id="@+id/products_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">

</LinearLayout>
<include layout="@layout/prototype_notice"/>
</LinearLayout>
</ScrollView>
