<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screen_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <ImageView android:id="@+id/details_icon" android:layout_width="match_parent" android:layout_height="180dp" android:padding="8dp" android:background="@drawable/product_image_background" android:scaleType="fitCenter" android:contentDescription="@null"/>
        <TextView android:id="@+id/details_image_caption" style="@style/Text.StopNShop.Support" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/details_category" style="@style/Text.StopNShop.Support" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/details_name" style="@style/Text.StopNShop.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/details_unit" style="@style/Text.StopNShop.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/details_price" style="@style/Text.StopNShop.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/details_provenance" style="@style/Text.StopNShop.Support" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.StopNShop.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/Text.StopNShop.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/select_quantity"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/details_minus" android:layout_width="64dp" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/minus"/>
                    <TextView android:id="@+id/details_quantity" style="@style/Text.StopNShop.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:accessibilityLiveRegion="polite"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/details_plus" android:layout_width="64dp" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/plus"/>
                </LinearLayout>
                <TextView android:id="@+id/details_subtotal" style="@style/Text.StopNShop.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.StopNShop.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/Text.StopNShop.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/product_details"/>
                <TextView android:id="@+id/details_description" style="@style/Text.StopNShop.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
                <TextView style="@style/Text.StopNShop.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/handling_heading"/>
                <TextView android:id="@+id/details_handling" style="@style/Text.StopNShop.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/details_add" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/add"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/details_cart" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/view_cart"/>
        <include layout="@layout/prototype_notice"/>
    </LinearLayout>
</ScrollView>
