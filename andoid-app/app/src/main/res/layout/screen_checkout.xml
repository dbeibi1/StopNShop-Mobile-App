<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screen_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <include layout="@layout/prototype_notice"/>
        <TextView style="@style/Text.StopNShop.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/checkout_intro"/>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.StopNShop.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/Text.StopNShop.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/customer_details"/>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/checkout_name_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/customer_name" app:errorEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/checkout_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPersonName" android:importantForAutofill="no" android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/checkout_phone_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/customer_phone" app:errorEnabled="true" app:helperText="@string/phone_example">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/checkout_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="phone" android:importantForAutofill="no" android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/checkout_location_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/customer_location" app:errorEnabled="true" app:helperText="@string/location_example">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/checkout_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPostalAddress|textMultiLine" android:importantForAutofill="no" android:minLines="2" android:gravity="top"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/checkout_errors" style="@style/Text.StopNShop.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/validation_summary" android:textColor="@color/error" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.StopNShop.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/Text.StopNShop.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/review_heading"/>
                <LinearLayout android:id="@+id/review_lines" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                <TextView android:id="@+id/review_count" style="@style/Text.StopNShop.Support" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
                <TextView style="@style/Text.StopNShop.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/demo_total"/>
                <TextView android:id="@+id/review_total" style="@style/Text.StopNShop.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/checkout_submit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/place_demo_order"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/checkout_edit_cart" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/edit_cart"/>
        <TextView style="@style/Text.StopNShop.Support" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/confirmation_notice"/>
    </LinearLayout>
</ScrollView>
